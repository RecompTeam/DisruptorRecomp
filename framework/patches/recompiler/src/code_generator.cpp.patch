+                }
+            }
+            const std::string_view mask = step_mask(probe);
+            if (mask.empty()) break;
+            members.push_back(probe);
+            masks.push_back(mask);
+            cursor = probe + 3;
+        }
+        if (members.size() == 1) {
+            for (std::size_t line = at; line < at + 3; ++line) out.append(lines[line]).push_back('\n');
+            at += 3;
+            continue;
+        }
+        std::string joined;
+        for (const std::string_view mask : masks) {
+            if (!joined.empty()) joined += ", ";
+            joined += mask;
+        }
+        out += "#if defined(PSX_ENABLE_BLOCK_CYCLES) && !defined(PSX_COSIM)\n";
+        out += fmt::format("{}psx_cyc_step{}(cpu, {});\n", indent, masks.size(), joined);
+        out += "#elif defined(PSX_ENABLE_BLOCK_CYCLES)\n";
+        out.append(lines[at + 1]).push_back('\n');
+        out += "#endif\n";
