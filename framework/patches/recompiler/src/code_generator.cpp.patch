+static std::string fuse_cycle_steps(const std::string& block, const std::string& indent) {
+    std::vector<std::string_view> lines;
+    for (std::size_t at = 0; at < block.size();) {
+        const std::size_t end = block.find('\n', at);
+        if (end == std::string::npos) {
+            lines.emplace_back(block.data() + at, block.size() - at);
+            break;
+        }
+        lines.emplace_back(block.data() + at, end - at);
+        at = end + 1;
+    }
+    const std::string step_prefix = indent + "psx_cyc_step(cpu, ";
+    auto step_mask = [&](std::size_t at) -> std::string_view {
+        if (at + 2 >= lines.size() || lines[at] != "#ifdef PSX_ENABLE_BLOCK_CYCLES" || lines[at + 2] != "#endif")
+            return {};
+        const std::string_view call = lines[at + 1];
+        if (!call.starts_with(step_prefix) || !call.ends_with(");")) return {};
+        return call.substr(step_prefix.size(), call.size() - step_prefix.size() - 2);
+    };
+    auto is_cosim_note = [&](std::size_t at) {
+        return at + 2 < lines.size() && lines[at] == "#ifdef PSX_COSIM" &&
+               lines[at + 1].starts_with(indent + "cosim_instr(") && lines[at + 2] == "#endif";
+    };
+
+    std::string out;
+    out.reserve(block.size() + block.size() / 8);
+    std::size_t at = 0;
+    while (at < lines.size()) {
+        const std::string_view head = step_mask(at);
+        if (head.empty()) {
+            out.append(lines[at]).push_back('\n');
+            ++at;
+            continue;
+        }
+        std::vector<std::size_t> members{at};
+        std::vector<std::string_view> masks{head};
+        std::size_t cursor = at + 3;
+        while (masks.size() < kFusedStepsMax) {
