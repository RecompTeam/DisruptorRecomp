+static constexpr std::size_t kFusedStepsMax = 4;
+
+static std::string_view trim_blank(std::string_view text) {
+    while (!text.empty() && (text.front() == ' ' || text.front() == '\t')) text.remove_prefix(1);
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\t' || text.back() == '\r')) text.remove_suffix(1);
+    return text;
+}
+
+static bool is_word_char(char c) {
+    return std::isalnum(static_cast<unsigned char>(c)) || c == '_';
+}
+
+static const std::set<std::string_view> kCastTypes = {
+    "uint32_t", "int32_t", "uint16_t", "int16_t", "uint8_t", "int8_t", "uint64_t", "int64_t"};
+
+/* The end of a general-register reference cpu->gpr[N] at `at`, N written plainly from 0 to 31, or npos. */
+static std::size_t general_register_end(std::string_view text, std::size_t at) {
+    if (!text.substr(at).starts_with("cpu->gpr[")) return std::string_view::npos;
+    std::size_t end = at + 9;
+    while (end < text.size() && std::isdigit(static_cast<unsigned char>(text[end]))) ++end;
+    const std::string_view digits = text.substr(at + 9, end - at - 9);
+    if (digits.empty() || digits.size() > 2 || (digits.size() == 2 && digits[0] == '0') || end >= text.size() ||
+        text[end] != ']')
+        return std::string_view::npos;
+    const int index = digits.size() == 1 ? digits[0] - '0' : (digits[0] - '0') * 10 + (digits[1] - '0');
+    return index <= 31 ? end + 1 : std::string_view::npos;
+}
+
+/* Whether the parenthesis closed at `close` opened a cast to an integer type. */
+static bool closes_cast(std::string_view text, std::size_t close) {
+    const std::size_t opening = text.rfind('(', close);
+    return opening != std::string_view::npos && kCastTypes.count(trim_blank(text.substr(opening + 1, close - opening - 1)));
+}
+
+/* The last character before `at` that is not a space, or 0. */
+static char operand_before(std::string_view text, std::size_t at, std::size_t& where) {
+    where = at;
+    while (where > 0 && text[where - 1] == ' ') --where;
+    return where == 0 ? '\0' : text[--where];
+}
+
+/* A line that writes only general registers or branch latches and reads only general registers, constants and casts. */
+static bool is_register_only_line(std::string_view line) {
+    std::string code;
+    for (std::size_t at = 0; at < line.size();) {
+        const std::size_t open = line.find("/*", at);
+        if (open == std::string_view::npos) {
+            code.append(line.substr(at));
+            break;
+        }
+        code.append(line.substr(at, open - at));
+        const std::size_t close = line.find("*/", open + 2);
+        if (close == std::string_view::npos) return false;
+        at = close + 2;
+    }
+    std::string_view text = trim_blank(code);
+    if (text.empty()) return true;
+    if (text.starts_with("uint32_t ")) text.remove_prefix(9);
+    else if (text.starts_with("int ")) text.remove_prefix(4);
+    std::size_t target_end = 0;
+    if (text.starts_with("cpu->gpr[")) {
+        target_end = general_register_end(text, 0);
+        if (target_end == std::string_view::npos) return false;
+    } else if (text.starts_with("_jt_") || text.starts_with("_bc_")) {
+        target_end = 4;
+        while (target_end < text.size() && std::isxdigit(static_cast<unsigned char>(text[target_end]))) ++target_end;
+        if (target_end != 12) return false;
+    } else {
+        return false;
+    }
+    const std::string_view rest = text.substr(target_end);
+    if (!rest.starts_with(" = ") || !rest.ends_with(';')) return false;
+    const std::string_view value = rest.substr(3, rest.size() - 4);
+    if (value.find('@') != std::string_view::npos) return false;
+    std::string reduced;
+    for (std::size_t at = 0; at < value.size();) {
+        if (value.substr(at).starts_with("cpu->gpr[")) {
+            const std::size_t end = general_register_end(value, at);
+            if (end == std::string_view::npos) return false;
+            reduced += '@';
+            at = end;
+            continue;
+        }
+        reduced += value[at++];
+    }
+    static constexpr std::string_view kAllowedMarks = " ()+-<>|^~!=?:&_@";
+    for (std::size_t at = 0; at < reduced.size(); ++at) {
+        const char c = reduced[at];
+        if (!std::isalnum(static_cast<unsigned char>(c)) && kAllowedMarks.find(c) == std::string_view::npos) return false;
+        if (c == '-' && at + 1 < reduced.size() && reduced[at + 1] == '>') return false;
+        std::size_t where = 0;
+        if (c == '(') {
+            const char before = operand_before(reduced, at, where);
+            if (is_word_char(before) || before == '@') return false;
+            if (before == ')' && !closes_cast(reduced, where)) return false;
+        }
+        if (c == '&' && (at == 0 || reduced[at - 1] != '&') && (at + 1 >= reduced.size() || reduced[at + 1] != '&')) {
+            const char before = operand_before(reduced, at, where);
+            if (!(is_word_char(before) || before == '@' || before == ')')) return false;
+            if (before == ')' && closes_cast(reduced, where)) return false;
+        }
+        if (!(std::isalpha(static_cast<unsigned char>(c)) || c == '_')) continue;
+        if (at > 0 && is_word_char(reduced[at - 1])) continue;
+        std::size_t end = at;
+        while (end < reduced.size() && is_word_char(reduced[end])) ++end;
+        if (!kCastTypes.count(std::string_view(reduced).substr(at, end - at))) return false;
+        at = end - 1;
+    }
+    return true;
+}
