+/* The per-instruction steps fuse_cycle_steps joined, put back from the co-simulation copies it keeps: the generator
+ * requires this to give back the block it was handed, so no step can be lost or changed on the way. */
+static std::string restore_cycle_steps(const std::string& fused, const std::string& indent) {
+    std::vector<std::string_view> lines;
