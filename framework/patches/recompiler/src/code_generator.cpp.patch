+                out.append(lines[line + 1]).push_back('\n');
+                out += "#endif\n";
+                line += 3;
+                ++member;
+            } else {
+                out.append(lines[line]).push_back('\n');
+                ++line;
+            }
+        }
+        at = cursor;
+    }
+    if (!block.ends_with('\n') && !out.empty()) out.pop_back();
+    return out;
