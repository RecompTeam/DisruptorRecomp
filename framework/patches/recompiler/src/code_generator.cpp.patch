+    for (std::size_t at = 0; at < lines.size();) {
+        if (lines[at] == "#if defined(PSX_ENABLE_BLOCK_CYCLES) && !defined(PSX_COSIM)" && at + 4 < lines.size() &&
+            lines[at + 2] == "#elif defined(PSX_ENABLE_BLOCK_CYCLES)" && lines[at + 3].starts_with(single) &&
