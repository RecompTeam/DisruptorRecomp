+// comparison at 4:3 and widening a camera-space horizontal cone without
+// touching its corresponding vertical test.
+struct WidescreenHorizontalSltSite {
+    uint32_t address = 0;
+    uint32_t expected = 0; // guarded signed register-register SLT
 };
 
