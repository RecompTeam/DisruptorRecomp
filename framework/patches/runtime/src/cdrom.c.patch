     cdrom_apply_savestate_delay_caps(/*log_clamps*/log_probe);
     if (log_probe)
@@ -3481,6 +3483,11 @@
 
 int cdrom_savestate_boost_vblanks_remaining(void) {
     return s_savestate_cd_boost_vblanks;
+}
+
+void cdrom_savestate_boost_hold(int held) {
