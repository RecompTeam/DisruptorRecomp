+
+/* User data of whole sectors read straight from the image, for a host that serves a stream itself. */
+int cdrom_read_user_sectors(uint32_t lba, uint32_t count, uint8_t* out) {
+    uint8_t raw[RAW_SECTOR_SIZE];
+    if (!iso_handle || !out) return 0;
+    for (uint32_t i = 0; i < count; i++) {
+        uint8_t* user = out + (size_t)i * SECTOR_SIZE;
+        if (iso_read_raw_sector(iso_handle, lba + i, raw, RAW_SECTOR_SIZE))
+            memcpy(user, raw + RAW_USER_DATA_OFFSET, SECTOR_SIZE);
+        else if (!iso_read_sector(iso_handle, lba + i, user, SECTOR_SIZE))
+            return 0;
+    }
+    return 1;
+}
