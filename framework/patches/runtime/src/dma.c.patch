+int psx_mod_dma_write_ram(uint32_t address, const void* data, uint32_t bytes,
+                          int lba) {
+    const uint8_t* source = (const uint8_t*)data;
+    const uint32_t addr = address & 0x1FFFFCu;
+    (void)lba;
+    if (!source || (address & 3u) || (bytes & 3u) || bytes > 0x200000u - addr)
+        return 0;
+    overlay_capture_before_dma(addr, bytes);
+    for (uint32_t at = 0; at < bytes; at += 4u)
+        psx_write_word(addr + at, (uint32_t)source[at] |
+                                  ((uint32_t)source[at + 1u] << 8) |
+                                  ((uint32_t)source[at + 2u] << 16) |
+                                  ((uint32_t)source[at + 3u] << 24));
+    dirty_ram_mark_executable_range(addr, bytes);
+    return 1;
 }
 
