+/* A step stays in main RAM's 2 MiB mirror, or in the opt-in GPU memory, whichever the address is in. */
+static uint32_t ch2_next(uint32_t addr, int32_t step) {
+    const uint32_t next = addr + (uint32_t)step;
+    return addr < 0x200000u ? next & 0x1FFFFCu : psx_mod_gpu_dma_resolve_address(next);
+}
