-                savestate_poll(cpu, s_compiled_interrupt_resume_pc);
+                if (save_point) savestate_poll(cpu, s_compiled_interrupt_resume_pc);
                 psx_netplay_poll_snap(cpu, s_compiled_interrupt_resume_pc);
