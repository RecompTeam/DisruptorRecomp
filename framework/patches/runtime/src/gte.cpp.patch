+        pinned.packed = packed;
+        pinned.clamped = 1;
+        precision_store_projection(physical, pinned);
+        ++s_precision_diagnostics.registered_store_accepts;
+        return;
+    }
+    precision_store_projection(physical, projection);
+    ++s_precision_diagnostics.registered_store_accepts;
+}
