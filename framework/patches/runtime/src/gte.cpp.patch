+static inline int precision_ram_address(uint32_t addr, uint32_t *physical) {
+    /* Match memory.c: KSEG2/KSEG3 are unmapped and must not alias low-RAM provenance. */
+    if (addr >= 0xC0000000u) return 0;
+    uint32_t mapped = addr & 0x1FFFFFFFu;
+    if (mapped >= 0x00800000u) {
+        if (mapped < PSX_MOD_GPU_DMA_APERTURE_BASE ||
+            mapped > PSX_MOD_GPU_DMA_APERTURE_BASE +
+                     PSX_MOD_GPU_DMA_APERTURE_SIZE - 4u) return 0;
+        *physical = mapped & ~3u;
+        return 1;
+    }
+    *physical = mapped & 0x1FFFFCu;
+    return 1;
+}
+
+static inline int precision_scratch_address(uint32_t addr,
+                                             uint32_t *physical) {
+    /* Same translation as memory.c, with KSEG2/KSEG3 kept from aliasing a scratchpad slot. */
+    if (addr >= 0xC0000000u) return 0;
+    const uint32_t mapped = addr & 0x1FFFFFFFu;
+    if (mapped < 0x1F800000u || mapped > 0x1F8003FFu) return 0;
+    *physical = mapped & ~3u;
+    return 1;
+}
+
+static inline int precision_copy_source_address(uint32_t addr,
