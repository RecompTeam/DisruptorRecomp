+extern "C" void gte_precision_diagnostics(GtePrecisionDiagnostics *out) {
+    if (out) *out = s_precision_diagnostics;
+}
+
+extern "C" void gte_precision_diagnostics_reset(void) {
+    s_precision_diagnostics = {};
