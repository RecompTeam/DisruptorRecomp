+static void precision_store_projection(
+        uint32_t physical, const PreciseProjection &projection) {
+    const uint32_t slot = precision_hash(physical);
+    PrecisionStoreTag &tag = s_precision_tag[slot];
+    if (tag.generation != 0 && tag.addr != physical) {
+        ++s_precision_diagnostics.store_collisions;
+        if (tag.generation == s_precision_generation)
+            ++s_precision_diagnostics.store_evictions;
+    }
+    tag.addr = physical;
+    s_precision_projection[slot] = projection;
+    tag.generation = s_precision_generation;
+    if (physical < 0x00200000u) {
+        g_gte_precision_ram_pages[physical >> 17] |= 1u << ((physical >> 12) & 31u);
+    } else if (physical - PSX_MOD_GPU_DMA_APERTURE_BASE < PSX_MOD_GPU_DMA_APERTURE_SIZE) {
+        const uint32_t page = (physical - PSX_MOD_GPU_DMA_APERTURE_BASE) >> 12;
+        g_gte_precision_dma_pages[page >> 5] |= 1u << (page & 31u);
+    } else {
+        g_gte_precision_scratch_live = 1;
+    }
