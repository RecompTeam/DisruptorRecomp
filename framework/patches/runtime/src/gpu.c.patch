+/* Classic-wide counterpart for engines which calculate perspective screen X
+ * in ordinary CPU code instead of the GTE. Exact recompiler sites call this
+ * immediately after adding the projection centre. Squashing here keeps the
+ * game's original non-negative 0..display-width portal spans and clip logic
+ * valid; the classic present stretch restores native proportions afterward.
+ * Native-wide and 4:3 are exact identities. Use 64-bit intermediates because
+ * a near-plane projection may be far outside the eventual screen clamp. */
+int psx_ws_project_x(int x) {
+    if (ws_mode != 1 || !ws_configured()) return x;
+    int64_t cx = (int64_t)ws_disp_w() / 2;
+    int64_t d = (int64_t)(int32_t)x - cx;
+    int64_t n = d * (int64_t)ws_xnum;
+    n += d >= 0 ? ws_xden / 2 : -ws_xden / 2;
+    return (int32_t)(cx + n / ws_xden);
+}
