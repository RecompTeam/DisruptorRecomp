+static uint32_t geometry_depth_bucket(uint16_t z) {
+    if (z < 256u) return 0;
+    if (z < 1024u) return 1;
+    if (z < 4096u) return 2;
+    if (z < 16384u) return 3;
+    if (z < 32768u) return 4;
+    return 5;
