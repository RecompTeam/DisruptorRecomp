+/* A port's sticks for the game, raw LX, LY, RX, RY, under dev input each from the pad pushed furthest. 0 without one. */
+extern "C" int psx_input_pad_sticks(int slot, int16_t out[4]) {
+    out[0] = out[1] = out[2] = out[3] = 0;
+#ifndef PSX_NO_DEBUG_TOOLS
+    unsigned char injected[4];
+    if (slot == 0 && debug_server_get_axis_override(injected)) {
+        for (int axis = 0; axis < 4; ++axis)
+            out[axis] = (int16_t)std::max(-32768, std::min(32767, (injected[axis] - 128) * 256));
+        return 1;
+    }
+#endif
+    if (slot < 0 || slot >= PSX_MAX_PLAYERS) return 0;
+    std::array<SDL_GameController*, 8> pads{};
+    std::size_t count = 0;
+    if (g_players[slot].kind == 2 && g_players[slot].handle) pads[count++] = g_players[slot].handle;
+    if (slot == 0 && dev_any_input_enabled()) {
+        for (int i = 0; i < SDL_NumJoysticks() && count < pads.size(); i++) {
+            if (!SDL_IsGameController(i)) continue;
+            SDL_GameController* h = SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i));
+            if (!h) h = SDL_GameControllerOpen(i);
+            if (h) pads[count++] = h;
+        }
+    }
+    if (count == 0) return 0;
+    double reach[2] = {-1.0, -1.0};
+    for (std::size_t at = 0; at < count; ++at) {
+        SDL_GameController* h = pads[at];
+        const int16_t axes[4] = {SDL_GameControllerGetAxis(h, SDL_CONTROLLER_AXIS_LEFTX), SDL_GameControllerGetAxis(h, SDL_CONTROLLER_AXIS_LEFTY),
+                                 SDL_GameControllerGetAxis(h, SDL_CONTROLLER_AXIS_RIGHTX), SDL_GameControllerGetAxis(h, SDL_CONTROLLER_AXIS_RIGHTY)};
+        for (int stick = 0; stick < 2; ++stick) {
+            const double length = std::hypot((double)axes[2 * stick], (double)axes[2 * stick + 1]);
+            if (length <= reach[stick]) continue;
+            reach[stick] = length;
+            out[2 * stick] = axes[2 * stick];
+            out[2 * stick + 1] = axes[2 * stick + 1];
+        }
+    }
+    return 1;
+}
