+    static std::vector<int> scratch;
+    static uint32_t last_w = 0, last_h = 0;
+    const size_t count = (size_t)w * h;
+    if (w == last_w && h == last_h && std::memcmp(last_shown.data(), buf, count * sizeof(uint32_t)) == 0) {
+        std::memcpy(buf, last_cleaned.data(), count * sizeof(uint32_t));
+        return true;
+    }
+    last_w = w;
+    last_h = h;
+    last_shown.assign(buf, buf + count);
+    movie_filter::clean(buf, (int)w, (int)h, scratch);
+    last_cleaned.assign(buf, buf + count);
+    return true;
+#else
+    (void)buf; (void)w; (void)h;
+    return false;
+#endif
+}
