+static PsxPadEdits s_pad_edits;
+
+extern "C" void psx_game_pad_word(int slot, uint16_t word) {
+    if (slot < 0 || slot > 1) return;
+    psx_pad_edits_word(&s_pad_edits, slot, word);
+    sio_set_pad_state_slot(slot, word);
+}
+
+extern "C" void psx_game_pad_press(int slot, uint16_t mask) {
+    if (slot < 0 || slot > 1) return;
+    psx_pad_edits_press(&s_pad_edits, slot, mask);
+    sio_set_pad_state_slot(slot, (uint16_t)(sio_get_pad_buttons_slot(slot) & ~mask));
+}
+
+extern "C" void psx_game_pad_release(int slot, uint16_t mask) {
+    if (slot < 0 || slot > 1) return;
+    psx_pad_edits_release(&s_pad_edits, slot, mask);
+    sio_set_pad_state_slot(slot, (uint16_t)(sio_get_pad_buttons_slot(slot) | mask));
+}
+
+extern "C" void psx_game_pad_sticks(int slot, uint8_t lx, uint8_t ly, uint8_t rx, uint8_t ry) {
+    if (slot < 0 || slot > 1) return;
+    const uint8_t sticks[4] = {lx, ly, rx, ry};
+    psx_pad_edits_sticks(&s_pad_edits, slot, sticks);
+    sio_set_pad_sticks(slot, lx, ly, rx, ry);
+}
+
+static void reapply_pad_edits(void) {
+    for (int slot = 0; slot < 2; ++slot) {
+        if (psx_pad_edits_any(&s_pad_edits, slot))
+            sio_set_pad_state_slot(slot, psx_pad_edits_apply(&s_pad_edits, slot, sio_get_pad_buttons_slot(slot)));
+        if (s_pad_edits.has_sticks[slot]) {
+            const uint8_t *s = s_pad_edits.sticks[slot];
+            sio_set_pad_sticks(slot, s[0], s[1], s[2], s[3]);
+        }
+    }
