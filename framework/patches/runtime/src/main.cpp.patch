+/* refresh_widescreen_projection takes a new aspect at the next VBlank, so a frame never mixes two. */
+/* The menu asks from its own thread: the frame takes the ask, sets the renderer's aspect too and reshapes a window. */
+static std::atomic<uint32_t> g_pending_display_aspect{0};
+static constexpr uint32_t kPendingAdaptiveOn = 0xFFFFFFFFu, kPendingAdaptiveOff = 0xFFFFFFFEu;
+/* What the frame applied, for the menu's getters on another thread: num << 16 | den, the top bit adaptive, 0 not yet. */
+static std::atomic<uint32_t> g_applied_display_aspect{0};
+static void publish_display_aspect(void) {
+    g_applied_display_aspect.store(((uint32_t)(g_video_aspect_num & 0x7FFF) << 16) | (uint32_t)(g_video_aspect_den & 0xFFFF) |
+                                       (g_ws_adaptive_view ? 0x80000000u : 0u),
+                                   std::memory_order_release);
+}
+
+extern "C" void psx_host_video_get_display_aspect(int *numerator, int *denominator) {
+    const uint32_t packed = g_pending_display_aspect.load(std::memory_order_acquire);
+    const bool fixed = packed != 0 && packed != kPendingAdaptiveOn && packed != kPendingAdaptiveOff;
+    const uint32_t applied = g_applied_display_aspect.load(std::memory_order_acquire);
+    if (numerator) *numerator = fixed ? (int)(packed >> 16) : applied ? (int)((applied >> 16) & 0x7FFFu) : g_video_aspect_num;
+    if (denominator) *denominator = fixed ? (int)(packed & 0xFFFFu) : applied ? (int)(applied & 0xFFFFu) : g_video_aspect_den;
+}
+
+extern "C" int psx_host_video_set_display_aspect(int numerator, int denominator) {
+    const bool offered = (numerator == 4 && denominator == 3) || (numerator == 16 && denominator == 9) ||
+                         (numerator == 21 && denominator == 9) || (numerator == 32 && denominator == 9);
+    if (!offered) return 0;
+    g_pending_display_aspect.store(((uint32_t)numerator << 16) | (uint32_t)denominator, std::memory_order_release);
+    return 1;
+}
+
+extern "C" int psx_host_video_get_adaptive_view(void) {
+    const uint32_t packed = g_pending_display_aspect.load(std::memory_order_acquire);
+    if (packed == kPendingAdaptiveOn) return 1;
+    if (packed != 0) return 0;
+    const uint32_t applied = g_applied_display_aspect.load(std::memory_order_acquire);
+    return applied ? (applied >> 31) : (g_ws_adaptive_view ? 1 : 0);
+}
+
+extern "C" int psx_host_video_set_adaptive_view(int enabled) {
+    if (enabled != 0 && enabled != 1) return 0;
+    if (enabled) {
+        g_pending_display_aspect.store(kPendingAdaptiveOn, std::memory_order_release);
+        return 1;
+    }
+    /* Off after a fixed ask keeps the ask: a fixed aspect is adaptive off already. */
+    uint32_t pending = g_pending_display_aspect.load(std::memory_order_acquire);
+    while ((pending == 0 || pending == kPendingAdaptiveOn) &&
+           !g_pending_display_aspect.compare_exchange_weak(pending, kPendingAdaptiveOff, std::memory_order_acq_rel)) {
+    }
+    return 1;
+}
+
+static void take_pending_display_aspect(void) {
+    const uint32_t packed = g_pending_display_aspect.exchange(0, std::memory_order_acq_rel);
+    if (packed == 0) return;
+    if (packed == kPendingAdaptiveOff) {
+        g_ws_adaptive_view = false;
+        return;
+    }
+    if (packed == kPendingAdaptiveOn) {
+        /* Every intermediate window ratio, capped at the audited 32:9 view. */
+        g_ws_adaptive_view = true;
+        g_ws_adaptive_max_num = 32;
+        g_ws_adaptive_max_den = 9;
+        return;
+    }
+    const int num = (int)(packed >> 16), den = (int)(packed & 0xFFFFu);
+    g_ws_adaptive_view = false;
+    g_video_aspect_num = num;
+    g_video_aspect_den = den;
+    gl_renderer_set_display_aspect(num, den);
+    vk_renderer_set_display_aspect(num, den);
+    if (sdl_renderer) {
+        g_logical_w = (int)((int64_t)480 * num * g_video_scale / den);
+        SDL_RenderSetLogicalSize(sdl_renderer, g_logical_w, 480 * g_video_scale);
+    }
+    if (sdl_window && (SDL_GetWindowFlags(sdl_window) & SDL_WINDOW_FULLSCREEN) == 0) {
+        int width = 0, height = 0;
+        SDL_GetWindowSize(sdl_window, &width, &height);
+        if (width > 0) {
+            height = width * den / num;
+            clamp_window_aspect(&width, &height, num, den);
+            SDL_SetWindowSize(sdl_window, width, height);
+        }
+    }
+    refresh_widescreen_projection();
+}
