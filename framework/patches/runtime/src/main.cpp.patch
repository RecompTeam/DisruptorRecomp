+
+// The folder of the running binary itself: inside an AppImage the read-only mount, not the .AppImage's folder.
+static std::filesystem::path image_dir() {
+#ifdef _WIN32
+    return {};
+#else
+    std::error_code ec;
+    const std::filesystem::path binary = std::filesystem::read_symlink("/proc/self/exe", ec);
+    return ec ? std::filesystem::path() : binary.parent_path();
+#endif
+}
+
+// A writable path the game's config resolved against the exe folder or the binary's own, placed in the user folder instead.
+static std::filesystem::path in_user_dir(const std::filesystem::path& path, const char* argv0) {
+    const std::filesystem::path moved = psx_moved_to_user_dir(path, exe_dir_from_argv(argv0), user_dir_from_argv(argv0));
+    const std::filesystem::path image = image_dir();
+    return moved != path || image.empty() ? moved : psx_moved_to_user_dir(path, image, user_dir_from_argv(argv0));
+}
+
+// A writable path from the settings or command line: relative to the user folder, one naming the exe folder moved there.
+static std::filesystem::path under_user_dir(const std::filesystem::path& path, const char* argv0) {
+    return path.is_relative() ? user_dir_from_argv(argv0) / path : in_user_dir(path, argv0);
