+/* Only an enabled package matches the image's digest: hashing it for none cost 6 s a start on a CHD, 1.7 s on a BIN. */
+const std::string& disc_digest() {
+    RuntimeMods& s = state();
+    if (!s.disc_sha256.empty() || s.disc_path.empty()) return s.disc_sha256;
+    for (const auto& [id, versions] : s.manager.packages()) {
+        (void)versions;
+        const ModPackage* package = selected_package(id);
+        if (!package || !package_has_enabled_feature(*package)) continue;
+        std::string hash_error;
+        if (!sha256_file(s.disc_path, s.disc_sha256, &hash_error)) s.disc_sha256.clear();
+        break;
+    }
+    return s.disc_sha256;
 }
 
