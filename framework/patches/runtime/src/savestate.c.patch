     if (s_save_pending < 0 && s_load_pending < 0) return;   /* hot path: nothing staged */
 
     if (s_save_pending >= 0) {
+        if (psx_frontend_savestate_deferred()) return;
         int slot = s_save_pending;
         s_save_pending = -1;
