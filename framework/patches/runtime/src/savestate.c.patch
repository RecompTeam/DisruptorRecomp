 /* Peek .pst header bios_checksum (BOOT_STATE wire: magic, version, checksum). */
+/* A state its header refuses never reaches the machine: no rollback then, whose GPU restore dropped the wide picture. */
+static int header_accepted(const uint8_t* state, size_t len) {
+    char reason[256];  /* without one the check passes every mismatch but the layout's */
+    return boot_state_check_buffer(state, len, s_bios_checksum, s_entry_pc, reason, sizeof(reason));
+}
+
+/* A slot file read once, so the check and the load see the same bytes. NULL when missing, unreadable or too big. */
+static uint8_t* read_state_file(const char* path, size_t* len) {
+    FILE* f = fopen(path, "rb");
+    uint8_t* bytes = NULL;
+    long size = -1;
+    *len = 0;
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END) == 0) size = ftell(f);
+    if (size > 0 && size <= 64L * 1024L * 1024L && fseek(f, 0, SEEK_SET) == 0)
+        bytes = (uint8_t*)malloc((size_t)size);
+    if (bytes && fread(bytes, 1, (size_t)size, f) != (size_t)size) {
+        free(bytes);
+        bytes = NULL;
+    }
+    fclose(f);
+    if (bytes) *len = (size_t)size;
+    return bytes;
+}
