-                        &s_pb_wide_w, &s_pb_wide_h);
-    for (int i = 0; i < PASS_JOURNAL_MAX; i++) {
-        PassJournal *e = &s_pj[i];
-        pass_free_color_fbo(&e->hr_tex, &e->hr_rb, &e->hr_fbo, &e->hr_w, &e->hr_h);
