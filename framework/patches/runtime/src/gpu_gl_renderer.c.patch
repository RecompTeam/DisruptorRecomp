+        while (end < count && kept[end].t0 <= span.t1) {
+            if (kept[end].t0 < span.t0) span.t0 = kept[end].t0;
+            if (kept[end].t1 > span.t1) span.t1 = kept[end].t1;
+            end++;
+        }
+        memmove(&kept[at + 1], &kept[end], (size_t)(count - end) * sizeof kept[0]);
+        kept[at] = span;
+        count += 1 - (end - at);
+    }
+    SDL_AtomicUnlock(&s_gz_lock);
+    int folded = 0;
+    while (folded < count && kept[folded].t1 + 500000000ull < kept[count - 1].t1) {
+        done_ms += (double)(kept[folded].t1 - kept[folded].t0) / 1.0e6;
+        done_until = kept[folded].t1;
+        folded++;
+    }
+    memmove(kept, &kept[folded], (size_t)(count - folded) * sizeof kept[0]);
+    count -= folded;
+    double ms = done_ms;
+    for (int i = 0; i < count; i++) ms += (double)(kept[i].t1 - kept[i].t0) / 1.0e6;
