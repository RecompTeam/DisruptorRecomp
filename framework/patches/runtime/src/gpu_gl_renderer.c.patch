-    /* The slots stand in for the window's back buffer: same channels, so
-     * destination alpha and readbacks behave as they did there. */
-    {
-        GLint a = 8;
-        typedef void (APIENTRY *PFN_gfap)(GLenum, GLenum, GLenum, GLint *);
