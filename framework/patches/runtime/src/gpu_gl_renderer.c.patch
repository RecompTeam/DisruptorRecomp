-static int fg_buf_of(int x, int y) {
-    for (int i = 0; i < s_fg_nbuf; i++)
-        if (x >= s_fg_buf[i][0] && x < s_fg_buf[i][0] + s_fg_buf[i][2] &&
-            y >= s_fg_buf[i][1] && y < s_fg_buf[i][1] + s_fg_buf[i][3]) return i;
-    return -1;
-}
