 static void gl_perf_init(void);   /* frame_perf — defined below, called from init_gpu_raster */
 static void gl_perf_mirror_begin(void); /* frame_perf: GPU-time bracket around ONE native-wide */
 static void gl_perf_mirror_end(void);   /* mirror pass (timestamp pair; splits scene canonical/mirror) */
+
+/* GPU time by pass: timestamp pairs read a few frames late, by context (0 the game's, 1 the in-between presenter's). With
+ * PSX_GL_ZONES=1 every zone is timed for the debug server's gpu_zones; asked by dynamic resolution, the outermost alone. */
+enum { GZ_CANON, GZ_MIRROR, GZ_DDGI, GZ_WIDE_RESOLVE, GZ_WIDE_RIMS, GZ_CAPTURE, GZ_SHADE, GZ_SHADE_DEPTH,
+       GZ_SHADE_AO, GZ_SHADE_MEASURE, GZ_SHADE_LAMPS, GZ_SHADE_MIX, GZ_PLAIN, GZ_UI, GZ_MIRROR_OUTLINE, GZ_MIRROR_FILLERS,
+       GZ_MIRROR_DRAW, GZ_MIRROR_DEPTH, GZ_BETWEEN, GZ_BETWEEN_CLEAR, GZ_BETWEEN_DRAW, GZ_BETWEEN_RESOLVE,
+       GZ_BETWEEN_RIMS, GZ_LAYER, GZ_WAIT, GZ_COUNT };
+static const char *const s_gz_names[GZ_COUNT] = {"canon", "mirror", "ddgi", "wide_resolve", "wide_rims", "capture", "shade",
+    "shade_depth", "shade_ao", "shade_measure", "shade_lamps", "shade_mix", "plain", "ui", "mirror_outline", "mirror_fillers",
+    "mirror_draw", "mirror_depth", "between", "between_clear", "between_draw", "between_resolve",
+    "between_rims", "layer", "wait"};
+#define GZ_NBUF 8
+#define GZ_PAIRS 2048
+#define GZ_DEPTH 8
+typedef struct {
+    GLuint q[GZ_NBUF][GZ_PAIRS * 2];
+    unsigned char zone[GZ_NBUF][GZ_PAIRS], outer[GZ_NBUF][GZ_PAIRS];
+    int n[GZ_NBUF], b, made, open[GZ_DEPTH], depth, pending_reset;
+    int on, every, busy;  /* the owner thread's, taken at its frame end */
+    uint64_t frames, dropped, dropped_shown;
+    double sum[GZ_COUNT];
+} GpuZones;
+static GpuZones s_gz[2];
+/* The game context's outermost passes' GPU spans, for gl_renderer_gpu_busy_ms. */
+#define GZ_SPANS 4096
+typedef struct { uint64_t t0, t1; } GpuSpan;
+static GpuSpan s_gz_ring[GZ_SPANS];
+static unsigned s_gz_head, s_gz_tail;
+static SDL_SpinLock s_gz_lock;
+static int s_gz_every = -1;
+static SDL_atomic_t s_gz_busy_wanted;
+static void gz_report(void);
+static void gz_begin_at(int context, int zone) {
+    GpuZones *z = &s_gz[context != 0];
+    if (!z->on) return;
+    if (!z->made) { for (int i = 0; i < GZ_NBUF; i++) p_glGenQueries(GZ_PAIRS * 2, z->q[i]); z->made = 1; }
+    if (z->depth >= GZ_DEPTH) { z->depth++; z->dropped++; return; }
+    if (z->n[z->b] >= GZ_PAIRS || (!z->every && z->depth > 0)) { z->open[z->depth++] = -1; z->dropped += z->depth == 1; return; }
+    const int pair = z->n[z->b]++;
+    z->zone[z->b][pair] = (unsigned char)zone;
+    z->outer[z->b][pair] = z->depth == 0;
+    p_glQueryCounter(z->q[z->b][pair * 2], GL_TIMESTAMP);
+    z->open[z->depth++] = pair;
+}
+static void gz_end_at(int context) {
+    GpuZones *z = &s_gz[context != 0];
+    if (z->depth <= 0) return;
+    const int pair = --z->depth < GZ_DEPTH ? z->open[z->depth] : -1;
+    if (pair >= 0) p_glQueryCounter(z->q[z->b][pair * 2 + 1], GL_TIMESTAMP);
+}
+/* At a context's frame end: the oldest buffer's pairs are summed and it becomes the next frame's. Asking for the zones
+ * takes effect here, so no pair is left half issued. */
+static void gz_frame(int context) {
+    GpuZones *z = &s_gz[context];
+    if (s_gz_every < 0) { const char *env = getenv("PSX_GL_ZONES"); s_gz_every = env && env[0] == '1'; }
+    const int busy = SDL_AtomicGet(&s_gz_busy_wanted) != 0;
+    double add[GZ_COUNT] = {0};
+    if (z->made) {
+        const int rd = (z->b + 1) % GZ_NBUF;
+        for (int i = 0; i < z->n[rd]; i++) {
+            GLuint64 t0 = 0, t1 = 0;
+            p_glGetQueryObjectui64v(z->q[rd][i * 2], GL_QUERY_RESULT, &t0);
+            p_glGetQueryObjectui64v(z->q[rd][i * 2 + 1], GL_QUERY_RESULT, &t1);
+            if (t1 <= t0) continue;
+            add[z->zone[rd][i]] += (double)(t1 - t0) / 1.0e6;
+            if (context != 0 || !z->busy || !z->outer[rd][i] || z->zone[rd][i] == GZ_WAIT) continue;
+            SDL_AtomicLock(&s_gz_lock);
+            if (s_gz_head - s_gz_tail < GZ_SPANS) s_gz_ring[s_gz_head++ % GZ_SPANS] = (GpuSpan){t0, t1};
+            SDL_AtomicUnlock(&s_gz_lock);
+        }
+        z->n[rd] = 0;
+        z->b = rd;
+    }
+    z->depth = 0;
+    z->every = s_gz_every;
+    z->busy = busy;
+    SDL_AtomicLock(&s_gz_lock);
+    if (z->pending_reset) { memset(z->sum, 0, sizeof z->sum); z->frames = z->dropped = 0; z->pending_reset = 0; }
+    if (z->made) {
+        for (int i = 0; i < GZ_COUNT; i++) z->sum[i] += add[i];
+        z->frames++;
+    }
+    z->dropped_shown = z->dropped;
+    z->on = (s_gz_every || busy) && p_glQueryCounter && p_glGetQueryObjectui64v;
+    const int report = s_gz_every && context == 0 && z->frames >= 600;
+    SDL_AtomicUnlock(&s_gz_lock);
+    if (report) gz_report();
+}
+/* With PSX_GL_ZONES=1, every 600 game frames: each context's zones in milliseconds a frame on stdout, then a reset. */
+static void gz_report(void) {
+    char line[2048];
+    int at = snprintf(line, sizeof line, "psxrecomp: gpu zones, ms a frame:");
+    SDL_AtomicLock(&s_gz_lock);
+    for (int c = 0; c < 2; c++) {
