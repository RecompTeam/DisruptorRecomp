-    return s_raster_ok && s_ctx && !s_cpu_auth_dual && !s_depth24_skip_up &&
-           !(s_hd_native_authority && s_rth_a0_open) &&
-           !gpu_display_is_depth24() && !s_interp_enabled && !s_pass_active &&
-           !psx_netplay_active() && !psx_openxr_session_active() &&
