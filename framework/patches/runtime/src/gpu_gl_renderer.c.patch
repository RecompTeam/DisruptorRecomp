+/* What reached the screen since the detailed log last asked: pictures, the in-between ones, the longest gap between two. */
+static SDL_SpinLock s_shown_count_lock;
+static unsigned     s_shown_pictures = 0, s_shown_between = 0;
+static uint64_t     s_shown_last = 0, s_shown_gap = 0;
+static int          s_shown_counting = 0;
+
+void gl_renderer_set_shown_count(int enabled) {
+    GL_RT_SYNC(__func__);
+    SDL_AtomicLock(&s_shown_count_lock);
+    s_shown_counting = enabled != 0;
+    s_shown_pictures = s_shown_between = 0;
+    s_shown_last = s_shown_gap = 0;
+    SDL_AtomicUnlock(&s_shown_count_lock);
+}
+
+static void shown_count(int kind) {
+    if (!s_shown_counting) return;
+    const uint64_t now = SDL_GetPerformanceCounter();
+    SDL_AtomicLock(&s_shown_count_lock);
+    if (s_shown_last && now - s_shown_last > s_shown_gap) s_shown_gap = now - s_shown_last;
+    s_shown_last = now;
+    ++s_shown_pictures;
+    if (kind) ++s_shown_between;
+    SDL_AtomicUnlock(&s_shown_count_lock);
+}
+
+void gl_renderer_shown_count_take(unsigned *pictures, unsigned *between, double *longest_ms) {
+    GL_RT_SYNC(__func__);
+    SDL_AtomicLock(&s_shown_count_lock);
+    *pictures = s_shown_pictures;
+    *between = s_shown_between;
+    *longest_ms = s_shown_pictures ? (double)s_shown_gap * 1000.0 / (double)SDL_GetPerformanceFrequency() : -1.0;
+    s_shown_pictures = s_shown_between = 0;
+    s_shown_gap = 0;
+    SDL_AtomicUnlock(&s_shown_count_lock);
+}
