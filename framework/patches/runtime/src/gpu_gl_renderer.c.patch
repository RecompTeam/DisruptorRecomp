-static int rth_rec_ints(uint16_t op, uint16_t flags, int n, const int32_t *v) {
-    int32_t *p = (int32_t *)rt_cmd_begin(op, flags, (uint32_t)n * 4u);
-    if (!p) return 0;
-    memcpy(p, v, (size_t)n * 4u);
-    rt_cmd_commit();
-    return 1;
-}
