+    gz_end_at(context);
+    if (outer < 0) return;
+    if (z->n[z->b] >= GZ_PAIRS) { z->open[0] = -1; return; }
+    const int pair = z->n[z->b]++;
+    z->zone[z->b][pair] = z->zone[z->b][outer];
+    z->outer[z->b][pair] = 1;
+    p_glQueryCounter(z->q[z->b][pair * 2], GL_TIMESTAMP);
