-        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA,
-                     GL_UNSIGNED_BYTE, NULL);
-        s_pass_begin_diag.gl_error = pass_gl_errors();
-        s_pgen_alloc_n[gi]++;
-        s_pass_allocs++;
-    }
-    return 1;
-}
