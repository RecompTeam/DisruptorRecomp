+    PFN_glDebugMessageCallback callback = (void *)SDL_GL_GetProcAddress("glDebugMessageCallback");
+    PFN_glDebugMessageControl control = (void *)SDL_GL_GetProcAddress("glDebugMessageControl");
+    if (!callback || !control) return;
