-            s_rth_ov.px[i] = (const uint32_t *)q;
-            s_rth_ov.w[i] = hd.w[i];
-            s_rth_ov.h[i] = hd.h[i];
-            q += (size_t)hd.w[i] * hd.h[i] * 4u;
-        }
-    const int32_t *a = hd.args;
