-
-static void pass_journal_rollback(void) {
-    int S = s_hr_scale;
-    for (int i = s_pj_cpu.n - 1; i >= 0; i--) {
-        PassJournal *j = &s_pj[i];
-        int x = s_pj_cpu.x[i], y = s_pj_cpu.y[i];
-        int w = s_pj_cpu.w[i], h = s_pj_cpu.h[i];
