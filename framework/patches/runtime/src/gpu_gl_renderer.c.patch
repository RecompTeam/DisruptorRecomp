+/* Under a part-step turn: the corners left of a triangle between the columns the turn can place, 0 for none, -1 to draw it whole. */
+static int turn_clip(const float px[3], const float py[3], int visual_flags, PsxTurnCorner cut[PSX_TURN_CLIP_MAX]) {
+    float low, high;
+    if (!visual_flags ||
+        !psx_turn_band(s_yaw_sin, s_yaw_cos, (float)g_wide_cur_base + s_yaw_center_x, s_yaw_focal_x, &low, &high))
+        return -1;
+    if (px[0] >= low && px[0] <= high && px[1] >= low && px[1] <= high && px[2] >= low && px[2] <= high) return -1;
+    return psx_turn_clip(px, py, low, high, cut);
+}
 
