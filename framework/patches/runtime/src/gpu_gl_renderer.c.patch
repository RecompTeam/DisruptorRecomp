-    if (!s_raster_ok || !s_ctx || !out || w <= 0 || h <= 0) return 0;
-    if (x < 0 || y < 0 || x + w > VRAM_W || y + h > VRAM_H) return 0;
-    int S = s_out_scale, W = w * S, H = h * S;
-    if ((int64_t)W * H > (int64_t)cap_px) return 0;
-    if (pitch_bytes < W * 4 || pitch_bytes % 4) return 0;
