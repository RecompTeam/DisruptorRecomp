+/* Milliseconds the GPU spent in the game context's outermost passes since the start, overlaps counted once. The
+ * in-between presenter's passes are left out: the resolution answers to the game's own frames. Spans older than half a
+ * second, or past the room, are folded into the total, and a later span is cut where the folded time ends, so nothing
+ * counts twice. One reader. */
+double gl_renderer_gpu_busy_ms(void) {
+    static GpuSpan kept[GZ_SPANS];
+    static int count = 0;
+    static double done_ms = 0.0;
+    static uint64_t done_until = 0;
+    SDL_AtomicLock(&s_gz_lock);
