+/* Average milliseconds a frame of each context for every zone since the last reset; the reset lands at its next frame. */
+uint64_t gl_renderer_gpu_zones(int reset, double out[2][GL_RENDERER_GPU_ZONES], uint64_t frames[2], uint64_t *dropped) {
+    for (int c = 0; c < 2; c++) for (int i = 0; i < GL_RENDERER_GPU_ZONES; i++) out[c][i] = 0.0;
