+/* A replay capsule's preview: one picture of what reaches the screen, read back the asked width wide and copied out once, rows top down.
+ * The game's thread asks and takes, whichever thread presents reads: every change of the state and of the picture is under the lock. */
+enum { SNAP_NONE, SNAP_ASKED, SNAP_READING, SNAP_WAITING };
+static SDL_SpinLock s_snap_lock;
+static int          s_snap_state = SNAP_NONE, s_snap_dropped = 0, s_snap_width = 0, s_snap_w = 0, s_snap_h = 0;
+static int          s_snap_sequence = -1, s_snap_taken_sequence = -1;  /* the logged picture read, -1 when no log runs */
+static uint8_t     *s_snap_pixels = NULL;
+
+int gl_renderer_snap_shown(int width) {
+    GL_RT_SYNC(__func__);
+    int asked = 0;
+    if (width < 64 || width > 3840) return 0;
+    SDL_AtomicLock(&s_snap_lock);
+    if (s_snap_state == SNAP_NONE || s_snap_state == SNAP_WAITING) {
+        s_snap_width = width;
+        s_snap_state = SNAP_ASKED;
+        asked = 1;
+    }
+    SDL_AtomicUnlock(&s_snap_lock);
+    return asked;
+}
+
+/* A picture asked for and no longer wanted is not handed over: one being read is dropped when its reading ends. */
+void gl_renderer_snap_cancel(void) {
+    GL_RT_SYNC(__func__);
+    SDL_AtomicLock(&s_snap_lock);
+    if (s_snap_state == SNAP_READING) s_snap_dropped = 1;
+    else s_snap_state = SNAP_NONE;
+    SDL_AtomicUnlock(&s_snap_lock);
+}
+
+int gl_renderer_snap_taken(unsigned char *rgb, int room, int *width, int *height) {
+    GL_RT_SYNC(__func__);
+    int taken = 0;
+    if (!rgb || !width || !height) return 0;
+    SDL_AtomicLock(&s_snap_lock);
+    if (s_snap_state == SNAP_WAITING) {
+        s_snap_state = SNAP_NONE;
+        if (s_snap_w * s_snap_h * 3 <= room) {
+            memcpy(rgb, s_snap_pixels, (size_t)s_snap_w * s_snap_h * 3);
+            *width = s_snap_w;
+            *height = s_snap_h;
+            s_snap_taken_sequence = s_snap_sequence;
+            taken = 1;
+        }
+    }
+    SDL_AtomicUnlock(&s_snap_lock);
+    return taken;
+}
+
+/* The logged picture the last handed over one was read from, -1 when none was logged. */
+int gl_renderer_snap_taken_sequence(void) {
+    SDL_AtomicLock(&s_snap_lock);
+    const int sequence = s_snap_taken_sequence;
+    SDL_AtomicUnlock(&s_snap_lock);
+    return sequence;
+}
+
+static void shown_snap(int sequence) {
+    int ww = 0, wh = 0, width = 0, height = 0, mine;
+    uint8_t *up = NULL, *down = NULL;
+    SDL_AtomicLock(&s_snap_lock);
+    mine = s_snap_state == SNAP_ASKED;
+    if (mine) s_snap_state = SNAP_READING;
+    width = s_snap_width;
+    SDL_AtomicUnlock(&s_snap_lock);
+    if (!mine) return;
+    gl_visible_size(&ww, &wh);
+    if (ww > 0 && wh > 0) {
+        width = width < ww ? width : ww;
+        height = width * wh / ww > 0 ? width * wh / ww : 1;
+        up = (uint8_t *)malloc((size_t)width * height * 3);
+        down = (uint8_t *)malloc((size_t)width * height * 3);
+    }
+    if (up && down) {
+        shown_read(0, 0, 0, ww, wh, width, height, up);
+        for (int y = 0; y < height; ++y) memcpy(down + (size_t)y * width * 3, up + (size_t)(height - 1 - y) * width * 3, (size_t)width * 3);
+    } else {
+        free(down);
+        down = NULL;
+    }
+    free(up);
+    SDL_AtomicLock(&s_snap_lock);
+    free(s_snap_pixels);
+    s_snap_pixels = down;
+    s_snap_w = width;
+    s_snap_h = height;
+    s_snap_sequence = sequence;
+    s_snap_state = down && !s_snap_dropped ? SNAP_WAITING : SNAP_NONE;
+    s_snap_dropped = 0;
+    SDL_AtomicUnlock(&s_snap_lock);
+}
