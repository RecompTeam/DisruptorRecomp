+        GpuSpan span = s_gz_ring[s_gz_tail++ % GZ_SPANS];
+        if (span.t0 < done_until) span.t0 = done_until;
+        if (span.t1 <= span.t0) continue;
+        if (count == GZ_SPANS) {
+            const int folded = GZ_SPANS / 2;
+            for (int i = 0; i < folded; i++) done_ms += (double)(kept[i].t1 - kept[i].t0) / 1.0e6;
+            done_until = kept[folded - 1].t1;
+            memmove(kept, &kept[folded], (size_t)(count - folded) * sizeof kept[0]);
+            count -= folded;
+            if (span.t0 < done_until) span.t0 = done_until;
+            if (span.t1 <= span.t0) continue;
+        }
+        int at = 0;
+        while (at < count && kept[at].t1 < span.t0) at++;
