+static void handle_gpu_zones(int id, const char *json)
+{
+    double ms[2][GL_RENDERER_GPU_ZONES];
+    uint64_t frames[2], dropped;
+    if (!gl_renderer_gpu_zones(json_get_int(json, "reset", 0), ms, frames, &dropped)) {
+        send_err(id, "no gpu_zones samples (start with PSX_GL_ZONES=1 in a debug build)");
+        return;
+    }
+    char body[3072];
+    int at = snprintf(body, sizeof body, "{\"id\":%d,\"ok\":true,\"frames\":[%llu,%llu],\"dropped\":%llu,\"ms\":{", id,
+                      (unsigned long long)frames[0], (unsigned long long)frames[1], (unsigned long long)dropped);
+    for (int i = 0; i < GL_RENDERER_GPU_ZONES && at < (int)sizeof body; i++)
+        at += snprintf(body + at, sizeof body - (size_t)at, "%s\"%s\":[%.4f,%.4f]", i ? "," : "",
+                       gl_renderer_gpu_zone_name(i), ms[0][i], ms[1][i]);
+    if (at < (int)sizeof body) snprintf(body + at, sizeof body - (size_t)at, "}}");
+    send_fmt("%s", body);
+}
