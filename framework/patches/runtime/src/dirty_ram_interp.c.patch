+/* One sample per 256 interpreted instructions identifies stable hot loops
+ * without turning production diagnostics into another per-insn profiler. The
+ * physical-PC direct table has no hash collisions and is touched only while
+ * PSX_RUNTIME_PERF_DIAG is enabled. */
+#define DIRTY_RAM_PERF_SAMPLE_SHIFT 8u
+#define DIRTY_RAM_PERF_SAMPLE_STRIDE (1u << DIRTY_RAM_PERF_SAMPLE_SHIFT)
+static int s_dirty_ram_perf_hot_enabled = 0;
+static uint32_t s_dirty_ram_perf_hot_samples[DIRTY_RAM_EXEC_WORD_COUNT];
+
+void dirty_ram_perf_hot_enable(int enabled) {
+    s_dirty_ram_perf_hot_enabled = enabled ? 1 : 0;
+    memset(s_dirty_ram_perf_hot_samples, 0,
+           sizeof(s_dirty_ram_perf_hot_samples));
+}
+
+static inline void dirty_ram_perf_hot_record(uint32_t pc) {
+    if (!s_dirty_ram_perf_hot_enabled ||
+        (g_dirty_ram_insns_run & (DIRTY_RAM_PERF_SAMPLE_STRIDE - 1u)) != 0u)
+        return;
+    uint32_t phys = pc & 0x1FFFFFFFu;
+    if (phys >= 2u * 1024u * 1024u || (phys & 3u) != 0u) return;
+    uint32_t *slot = &s_dirty_ram_perf_hot_samples[phys >> 2];
+    if (*slot != UINT32_MAX) (*slot)++;
+}
+
+void dirty_ram_perf_take_hot(uint32_t pcs[DIRTY_RAM_PERF_HOT_COUNT],
+                             uint32_t samples[DIRTY_RAM_PERF_HOT_COUNT],
+                             uint32_t *stride) {
+    uint32_t top_pc[DIRTY_RAM_PERF_HOT_COUNT] = {0};
+    uint32_t top_n[DIRTY_RAM_PERF_HOT_COUNT] = {0};
+    for (uint32_t word = 0; word < DIRTY_RAM_EXEC_WORD_COUNT; word++) {
+        uint32_t n = s_dirty_ram_perf_hot_samples[word];
+        if (n == 0u || n <= top_n[DIRTY_RAM_PERF_HOT_COUNT - 1u]) continue;
+        uint32_t at = DIRTY_RAM_PERF_HOT_COUNT - 1u;
+        while (at > 0u && n > top_n[at - 1u]) {
+            top_n[at] = top_n[at - 1u];
+            top_pc[at] = top_pc[at - 1u];
+            at--;
+        }
+        top_n[at] = n;
+        top_pc[at] = word << 2;
+    }
+    memset(s_dirty_ram_perf_hot_samples, 0,
+           sizeof(s_dirty_ram_perf_hot_samples));
+    if (pcs) memcpy(pcs, top_pc, sizeof(top_pc));
+    if (samples) memcpy(samples, top_n, sizeof(top_n));
+    if (stride) *stride = DIRTY_RAM_PERF_SAMPLE_STRIDE;
+}
