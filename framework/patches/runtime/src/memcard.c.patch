+/* The card goes to an exclusive temporary beside it, then replaces it: a process dying mid-write keeps the old card. */
+static int publish_card(const char* path, const uint8_t* data) {
+    static unsigned sequence;
+    char temporary[576];
+    int descriptor = -1;
+    for (unsigned attempt = 0; attempt < 32u && descriptor < 0; ++attempt) {
+#ifdef _WIN32
+        snprintf(temporary, sizeof temporary, "%s.tmp.%lu.%u", path, (unsigned long)_getpid(), ++sequence);
+        descriptor = _open(temporary, _O_WRONLY | _O_CREAT | _O_EXCL | _O_BINARY, _S_IREAD | _S_IWRITE);
+#else
+        snprintf(temporary, sizeof temporary, "%s.tmp.%lu.%u", path, (unsigned long)getpid(), ++sequence);
+        descriptor = open(temporary, O_WRONLY | O_CREAT | O_EXCL, 0600);
+#endif
+    }
+    if (descriptor < 0) return -1;
+#ifdef _WIN32
+    FILE* f = _fdopen(descriptor, "wb");
+    if (!f) _close(descriptor);
+#else
+    FILE* f = fdopen(descriptor, "wb");
+    if (!f) close(descriptor);
+#endif
+    int ok = f && fwrite(data, 1, MEMCARD_SIZE, f) == MEMCARD_SIZE && fflush(f) == 0;
+#ifdef _WIN32
+    if (ok && _commit(_fileno(f)) != 0) ok = 0;
+#else
+    if (ok && fsync(fileno(f)) != 0) ok = 0;
+#endif
+    if (f && fclose(f) != 0) ok = 0;
+#ifdef _WIN32
+    if (ok) ok = MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    if (ok) ok = rename(temporary, path) == 0;
+#endif
+    if (!ok) remove(temporary);
+    return ok ? 0 : -1;
+}
 
