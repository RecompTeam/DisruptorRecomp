+int32_t psx_ws_cull_lower_value(int32_t vanilla) {
+    return vanilla - psx_ws_x_margin();
+}
+int32_t psx_ws_cull_upper_value(int32_t vanilla) {
+    return vanilla + psx_ws_x_margin();
+}
+uint32_t psx_ws_cull_span_value(uint32_t vanilla) {
+    int32_t margin = psx_ws_x_margin();
+    int32_t left = (int32_t)(int16_t)(uint16_t)(vanilla >> 16);
+    uint32_t right = vanilla & 0xFFFFu;
+    return ((uint32_t)(uint16_t)(left - margin) << 16) |
+           (uint32_t)(uint16_t)((int32_t)right + margin);
+}
