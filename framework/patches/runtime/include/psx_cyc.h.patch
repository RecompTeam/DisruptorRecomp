+/* psx_cyc_step_inline for each mask in turn, for instructions with no timing between them. After the first DO_LDS
+ * the slot is 0x20 and ReadAbsorbWhich is fixed, so the rest only count down, clear and charge the one slot. */
+PSX_CYC_HOT void psx_cyc_run_inline(CPUState* cpu, const uint32_t* masks, unsigned count) {
+    uint32_t charges = 0u;
+    uint8_t which = cpu->read_absorb_which;
+    if (cpu->read_absorb[which]) cpu->read_absorb[which]--;
+    else                         charges = 1u;
+    psx_cyc_deps(cpu, masks[0]);
+    psx_cyc_lds(cpu);
+    which = cpu->read_absorb_which;
+    uint8_t absorb = cpu->read_absorb[which];
+    uint32_t cleared = 0u;
+    for (unsigned k = 1u; k < count; ++k) {
+        if (absorb) absorb--;
+        else        charges++;
+        const uint32_t mask = masks[k] & 0xFFFFFFFEu;
+        if ((mask >> which) & 1u) absorb = 0u;
+        cleared |= mask;
+    }
+    psx_cyc_deps(cpu, cleared);
+    cpu->read_absorb[which] = absorb;
+    cpu->read_absorb[32] = (uint8_t)cpu->ld_absorb;
+    cpu->read_fudge = 0x20u;
+    psx_cyc_charge_ones(charges);
+}
